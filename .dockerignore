# ═══════════════════════════════════════════════════════════════
# .dockerignore — Keep the Docker image lightweight (<500 MB)
# ═══════════════════════════════════════════════════════════════

# ── Version control ──────────────────────────────────────────
.git
.gitignore

# ── Python bytecode ──────────────────────────────────────────
__pycache__
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments ────────────────────────────────────
env/
venv/
.env
.venv/

# ── Training data & raw CSVs (200+ MB) ──────────────────────
Raw/
data/
notebooks/
outputs/

# ── Training scripts (not needed in production) ─────────────
train_models.py
optimize_model.py
main.py
reset_mysql.ps1

# ── Database files (MySQL not available on HF Spaces) ───────
traffic_history.db
*.db

# ── Deployment configs for other platforms ───────────────────
render.yaml
gunicorn.conf.py

# ── IDE / OS artifacts ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# ── Scratch / temp ──────────────────────────────────────────
scratch/
